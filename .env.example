# Copiez ce fichier en ".env" (à la racine du projet) et remplissez les valeurs.
# Le ".env" ne doit JAMAIS être commité (déjà exclu via .gitignore).

# ==================== OBLIGATOIRE ====================

# Token du bot Telegram, obtenu via @BotFather
BOT_TOKEN=

# IDs Telegram des administrateurs du bot, séparés par des virgules (sans espace)
# Exemple : ADMIN_IDS=111111111,222222222
ADMIN_IDS=

# ==================== PAIEMENTS AUTOMATIQUES (API Atelier) ====================
# Doc : https://myateliers.store/docs/api
# Clé générée depuis : https://myateliers.store/dashboard/settings/api

ATELIER_API_KEY=

# URL publique (HTTPS de préférence) qui reçoit les webhooks de paiement,
# doit pointer vers WEBHOOK_SERVER_PORT (8081 par défaut) de ce serveur.
# Exemple : https://votre-domaine.com/webhooks/atelier
ATELIER_CALLBACK_URL=

# Lien vers lequel l'utilisateur est redirigé après paiement (ex: https://t.me/VotreBot)
ATELIER_RETURN_URL=

# Prix de l'abonnement Premium en Francs CFA (XOF, entier sans décimales)
PREMIUM_PRICE_XOF=2000

# ==================== OPTIONNEL ====================

# Nom d'utilisateur affiché comme propriétaire du bot dans /start
OWNER_USERNAME=@VotrePseudo

# Serveur HTTP interne qui reçoit les webhooks Atelier
WEBHOOK_SERVER_HOST=0.0.0.0
WEBHOOK_SERVER_PORT=8081
